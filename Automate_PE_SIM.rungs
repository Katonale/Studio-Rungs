version: 5
origin: studio
aoi:
  name: Automate_PE_SIM
  description: Simulate PEs to flagging without having to toggle it manually - not for Production uses
  parameters:
    - name: EnableIn
      dataType: BOOL
      usage: input
      defaultValue: 1
      description: Enable Input - System Defined Parameter
    - name: EnableOut
      dataType: BOOL
      usage: output
      description: Enable Output - System Defined Parameter
  localTags:
    - name: PE
      dataType: BOOL
    - name: PE_CYCLES
      dataType: COUNTER
      defaultValue:
        PRE: 10
    - name: COUNT_CYCLE_COMPLETE
      dataType: BOOL
    - name: PE_TRIG_TIMER
      dataType: TIMER
      defaultValue:
        PRE: 500
    - name: COMPLETE_CLEAR_TIMER
      dataType: TIMER
      defaultValue:
        PRE: 3000
  routines:
    Logic:
      type: ld
      content: |-
        XIC(PE)CTU(PE_CYCLES,?,?);
        XIC(PE_CYCLES.DN)OTE(COUNT_CYCLE_COMPLETE);
        XIC(COUNT_CYCLE_COMPLETE)TON(COMPLETE_CLEAR_TIMER,?,?);
        XIC(COMPLETE_CLEAR_TIMER.DN)RES(PE_CYCLES);
        XIO(PE_TRIG_TIMER.DN)XIO(PE)TON(PE_TRIG_TIMER,?,?);
        XIC(PE_TRIG_TIMER.DN)OTE(PE);
